# --- App ---
ENVIRONMENT=development
# Local por defecto. La URL de produccion queda comentada; descomentar SOLO
# con permiso explicito y volver a comentar al terminar.
DATABASE_URL=postgresql+asyncpg://vesper:vesper@localhost:55432/vesper_dev
# DATABASE_URL=postgresql+asyncpg://USER:PASS@PROD_HOST:5432/vesper_prod

# --- Auth (F2, placeholders validos para arrancar F1) ---
# Minimo 32 caracteres. El default de desarrollo (`DEV_JWT_SECRET_DEFAULT`
# en config.py) NO debe llegar a produccion: config.py aborta el arranque
# si `ENVIRONMENT=production` y sigue ese valor.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (produccion: dominio del frontend) ---
# CSV de origenes. Vacio (default) = sin CORS abierto (mismo-origen).
CORS_ORIGINS=

# --- Redis (opcional en dev, REQUERIDO en produccion desde F5) ---
# Cola de jobs (Arq) + bus de eventos SSE. Sin esto, la cola degrada a
# `asyncio.create_task` dentro del proceso de la API y el cron NO corre: el
# tick vive en el worker (`arq src.worker.WorkerSettings`), que necesita Redis.
# En dev es aceptable; en produccion significa que nada se dispara solo.
REDIS_URL=

# --- Credenciales de IA (BYOK) ---
# Clave maestra con la que se cifran las API keys de los tenants. Perderla
# equivale a perder todas las credenciales guardadas: respaldala.
# En produccion es obligatoria; con el default de desarrollo el arranque aborta.
CREDENTIALS_ENCRYPTION_KEY=

# Key de la instancia, para tenants que no han configurado la suya. Solo se usa
# si enciendes el fallback: en una instancia compartida, regalar tu saldo a
# desconocidos debe ser una decision consciente. NO va al bundle del frontend.
OPENCODE_ZEN_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/go/v1
ALLOW_INSTANCE_KEY_FALLBACK=false

# --- Agent runtime (F4+) ---
# Path al binario opencode. Vacio = usar `opencode` del PATH.
OPENCODE_BIN=
# Pool de puertos para `opencode serve` (uno por job).
OPENCODE_PORT_POOL_START=14096
# Raiz de los workspaces clonados. El default (`/var/workspaces`) es la ruta
# del contenedor; en Windows/macOS apunta esto a un directorio temporal real.
WORKSPACE_ROOT=/var/workspaces

# --- GitHub App (F3+) ---
# No rellenes esto a mano: `python scripts/create_github_app.py --name "..."`
# crea la App con el manifest flow y escribe las seis claves de golpe.
# La clave privada va en una linea, con los saltos escapados como \n y entre
# comillas dobles; config.py la restaura.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Firma los webhooks de GitHub (F5). Sin el, POST /api/v1/webhooks/github
# responde 503 y no acepta ningun evento: falla cerrado a proposito.
GITHUB_WEBHOOK_SECRET=
