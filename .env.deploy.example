# .env.deploy.example
#
# Plantilla de las env vars que Coolify debe setear para el
# docker-compose.deploy.yml. COPIAR los valores al panel de Coolify, NO al
# repo. Los accesos al servidor y el token de la API de Coolify NUNCA van
# aqui ni en ningun archivo del repo.

# --- Postgres ---
POSTGRES_USER=vesper
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=vesper_prod
# DATABASE_URL debe apuntar al servicio `postgres` dentro del compose.
DATABASE_URL=postgresql+asyncpg://vesper:changeme-strong-password@postgres:5432/vesper_prod

# --- Backend ---
ENVIRONMENT=production
# false = solo se permite crear la primera cuenta (la tuya). Abrirlo a terceros
# no es seguro hasta que cada job corra en su propio contenedor.
REGISTRATION_ENABLED=false
JWT_SECRET=generate-a-32+-char-secret-and-paste-here
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guardala aparte: perderla = perder las credenciales de IA de todos los tenants.
CREDENTIALS_ENCRYPTION_KEY=
REDIS_URL=redis://redis:6379/0
# CSV de origenes permitidos para CORS. Solo el dominio publico del frontend.
CORS_ORIGINS=https://vesper.example.com

# --- Zen gateway (F4+) ---
OPENCODE_ZEN_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/go/v1

# --- Agent runtime (F4+ / F6b) ---
OPENCODE_BIN=/usr/local/bin/opencode
OPENCODE_PORT_POOL_START=14096
# Motor del agente: `opencode` (local, solo para repos propios) o `docker`
# (contenedor sin privilegios por job en anfitrion aparte; ver deploy/jobs-host/README.md).
AGENT_ENGINE=opencode
AGENT_IMAGE=vesper-agent:1
AGENT_DOCKER_NETWORK=vesper-jobs
AGENT_JOB_CPUS=2
AGENT_JOB_MEMORY=4g
AGENT_MAX_JOBS=3
# Con AGENT_ENGINE=docker: apuntar al anfitrion de jobs (TCP + TLS mutuo) y
# copiar ca.pem, cert.pem y key.pem al volumen `docker_certs` (/run/docker-certs).
DOCKER_HOST=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=

# --- GitHub App (F3+) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- Frontend (build-time) ---
# Cambios de estos valores exigen REBUILD del frontend (se incrustan en el
# bundle). En Coolify: pasarlos como build args.
NEXT_PUBLIC_API_URL=https://vesper.example.com/api/v1
NEXT_PUBLIC_SSE_URL=https://vesper.example.com
